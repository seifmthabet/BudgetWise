<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefWidth="1000" prefHeight="650"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.budgetwise.budgetwise.controllers.LandingController"
            style="-fx-background-color: linear-gradient(to bottom right,#0f172a,#1e293b);">

    <children>

        <!-- 🫧 BUBBLES -->
        <Circle fx:id="bubble1" radius="70"
                layoutX="120" layoutY="120"
                style="-fx-fill: linear-gradient(#ff7eb3,#ff758c); -fx-opacity:0.3;"/>

        <Circle fx:id="bubble2" radius="50"
                layoutX="850" layoutY="150"
                style="-fx-fill:#6366f1; -fx-opacity:0.2;"/>

        <Circle fx:id="bubble3" radius="30"
                layoutX="700" layoutY="550"
                style="-fx-fill:#22c55e; -fx-opacity:0.2;"/>

        <!-- 🧊 MAIN CARD -->
        <VBox alignment="CENTER" spacing="20"
              layoutX="250" layoutY="80"
              prefWidth="500"
              style="-fx-background-color: rgba(17,24,39,0.85);
                     -fx-padding:40;
                     -fx-background-radius:25;
                     -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.5), 25,0,0,5);">

            <!-- APP NAME -->
            <Label text="Investors"
                   style="-fx-text-fill:white; -fx-font-size:34; -fx-font-weight:bold;"/>

            <Label text="Smart Budget and Investment Tracking"
                   style="-fx-text-fill:#9ca3af; -fx-font-size:14;"/>

            <!-- BUTTONS -->
            <HBox spacing="15" alignment="CENTER">

                <Button text="Login"
                        onAction="#goToLogin"
                        style="-fx-background-color: linear-gradient(to right,#ff7eb3,#ff758c);
                               -fx-text-fill:white;
                               -fx-background-radius:12;
                               -fx-padding:10 25;
                               -fx-font-weight:bold;"/>

                <Button text="Register"
                        onAction="#goToRegister"
                        style="-fx-background-color:#1f2937;
                               -fx-text-fill:white;
                               -fx-background-radius:12;
                               -fx-padding:10 25;"/>

            </HBox>

            <!-- TEAM SECTION -->
            <VBox spacing="5" alignment="CENTER"
                  style="-fx-padding:20 0 0 0;">

                <Label text="Developed By"
                       style="-fx-text-fill:#9ca3af; -fx-font-size:14;"/>

                <Label text="Seif Mohamed Thabet (Team Leader and Software Engineer)"
                       style="-fx-text-fill:white;"/>

                <Label text="Abdullah Basyouni (Software Engineer and UI Designer)"
                       style="-fx-text-fill:white;"/>

                <Label text="Kareem Essam Rafee (Software Engineer)"
                       style="-fx-text-fill:white;"/>

                <Label text="Mazen Aba El-Mahasen (Software Engineer)"
                       style="-fx-text-fill:white;"/>

            </VBox>

        </VBox>

    </children>

</AnchorPane>