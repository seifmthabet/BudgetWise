<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="borderPane" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: linear-gradient(to bottom right,#0f172a,#1e293b);  " xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.budgetwise.budgetwise.controllers.GoalController">

    <top>
        <Pane prefHeight="0" />
    </top>

    <left>
        <VBox spacing="15" style="-fx-background-color:#111827; -fx-padding:20; -fx-pref-width:220;">

            <Label style="-fx-text-fill:white; -fx-font-size:20; -fx-font-weight:bold;" text="BudgetWise" />

            <Button fx:id="dashboardBtn" onAction="#goToDashboard" style="-fx-background-color:transparent; -fx-text-fill:#9ca3af;" text="Dashboard" />
            <Button fx:id="transactionBtn" onAction="#goToTransaction" style="-fx-background-color:transparent; -fx-text-fill:#9ca3af;" text="Transactions" />
            <Button fx:id="budgetBtn" onAction="#goToBudget" style="-fx-background-color:transparent; -fx-text-fill:#9ca3af;" text="Budgets" />
            <Button fx:id="goalBtn" onAction="#goToGoal" style="-fx-background-color:linear-gradient(to right,#ff7eb3,#ff758c); -fx-text-fill:white;" text="Goals" />
            <Button fx:id="notificationBtn" onAction="#goToNotification" style="-fx-background-color:transparent; -fx-text-fill:#9ca3af;" text="Notifications" />
            <Button fx:id="reportBtn" onAction="#goToReport" style="-fx-background-color:transparent; -fx-text-fill:#9ca3af;" text="Reports" />
        </VBox>
    </left>

    <center>
        <!-- ================= MAIN CONTENT ================= -->
        <VBox spacing="20" style="-fx-padding:30;">

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label style="-fx-text-fill:white; -fx-font-size:24; -fx-font-weight:bold;" text="🎯 Goals" />

                <Button onAction="#showForm" style="-fx-background-color: linear-gradient(to right,#ff7eb3,#ff758c);                            -fx-text-fill:white;" text="+ Add Goal" />
            </HBox>

            <!-- GOALS LIST -->
            <ListView fx:id="goalList" prefHeight="400" style="-fx-background-color:#1f2937; -fx-background-radius:10;" />

        </VBox>


        <!-- ================= OVERLAY FORM ================= -->
<!--        <AnchorPane fx:id="formOverlay" style="-fx-background-color: rgba(0,0,0,0.6);" visible="false">-->

