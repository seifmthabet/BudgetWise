<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-color:#0f172a;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.budgetwise.budgetwise.controllers.AuthController">

   <children>

      <VBox alignment="CENTER" layoutX="668.0" layoutY="352.0" spacing="15" style="-fx-background-color:#111827; -fx-padding:40; -fx-background-radius:20;">

         <Label style="-fx-text-fill:white; -fx-font-size:26; -fx-font-weight:bold;" text="Sign in" />

         <TextField fx:id="emailField" promptText="Email" style="-fx-background-color:#1f2937; -fx-text-fill:white; -fx-background-radius:10;" />

         <PasswordField fx:id="passwordField" promptText="Password" style="-fx-background-color:#1f2937; -fx-text-fill:white; -fx-background-radius:10;" />

         <Button onAction="#handleLogin" style="-fx-background-color: linear-gradient(to right,#ff7eb3,#ff758c);                            -fx-text-fill:white;                            -fx-background-radius:10;                            -fx-padding:10 20;" text="Sign in" />

      </VBox>

   </children>

</AnchorPane>
