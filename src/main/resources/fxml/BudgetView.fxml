            <!-- HEADER -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="💰 Budgets"
                       style="-fx-text-fill:white; -fx-font-size:24; -fx-font-weight:bold;"/>

                <Button text="+ New Budget"
