<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane stylesheets="@../css/app.css"
           xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.budgetwise.budgetwise.controllers.BudgetController">

    <VBox spacing="20" style="-fx-background-color: linear-gradient(to bottom right,#0f172a,#1e293b); -fx-padding:30;">

        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label style="-fx-text-fill:white; -fx-font-size:26; -fx-font-weight:bold;" text="Budgets" />
            <Pane HBox.hgrow="ALWAYS" /> <Button onAction="#showEditForm" styleClass="btn-secondary" text="✎ Edit Budgets" />
            <Button onAction="#showForm" styleClass="btn-primary" text="+ New Budget" />
        </HBox>

        <VBox spacing="15" styleClass="card-glass" style="-fx-padding: 20;" VBox.vgrow="ALWAYS">
            <Label style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;" text="Active Budgets" />

            <TableView fx:id="budgetTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="categoryColumn" prefWidth="150" text="Category" />
                    <TableColumn fx:id="amountColumn" prefWidth="120" text="Budgeted" />
                    <TableColumn fx:id="spentColumn" prefWidth="120" text="Spent" />
                    <TableColumn fx:id="remainingColumn" prefWidth="120" text="Remaining" />
                    <TableColumn fx:id="startDateColumn" prefWidth="130" text="Start Date" />
                    <TableColumn fx:id="endDateColumn" prefWidth="130" text="End Date" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>

    <AnchorPane fx:id="formcreateOverlay" style="-fx-background-color: rgba(0,0,0,0.6);" visible="false">
        <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <VBox alignment="CENTER" maxWidth="350" spacing="18" styleClass="modal-dialog" style="-fx-padding:40;">
                <Label style="-fx-text-fill:white; -fx-font-size:22; -fx-font-weight:bold;" text="Create Budget" />

                <ComboBox fx:id="categoryBox" maxWidth="Infinity" promptText="Select Category" />
                <TextField fx:id="amountField" maxWidth="Infinity" promptText="Budget Amount ($)" />
                <DatePicker fx:id="startDatePicker" maxWidth="Infinity" promptText="Start Date" />
                <DatePicker fx:id="endDatePicker" maxWidth="Infinity" promptText="End Date" />
                <TextField fx:id="alertField" maxWidth="Infinity" promptText="Alert Threshold (e.g. 80%)" />

                <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10 0 0 0;">
                    <Button onAction="#hideForm" styleClass="btn-secondary" text="Cancel" prefWidth="100"/>
                    <Button onAction="#handleSaveBudget" style="-fx-background-color:#10b981; -fx-text-fill:white; -fx-background-radius:8; -fx-font-weight:bold; -fx-cursor:hand;" text="Save Budget" prefWidth="100"/>
                </HBox>
            </VBox>
        </StackPane>
    </AnchorPane>

    <AnchorPane fx:id="editOverlay" style="-fx-background-color: rgba(0,0,0,0.6);" visible="false">
        <StackPane AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

            <VBox spacing="20" maxWidth="600" alignment="CENTER" styleClass="modal-dialog" style="-fx-padding:40;">
                <Label text="Edit Budgets" style="-fx-text-fill:white; -fx-font-size:22; -fx-font-weight:bold;"/>

                <ListView fx:id="budgetListView" prefHeight="250" maxWidth="Infinity"
                          style="-fx-background-color: rgba(31,41,55,0.5); -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8;"/>

                <HBox spacing="15" alignment="CENTER">
                    <TextField fx:id="editAmountField" promptText="Amount ($)" HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="editAlertField" promptText="Alert %" HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox spacing="15" alignment="CENTER">
                    <DatePicker fx:id="editStartDatePicker" HBox.hgrow="ALWAYS"/>
                    <DatePicker fx:id="editEndDatePicker" HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox spacing="15" alignment="CENTER" style="-fx-padding: 15 0 0 0;">
                    <Button text="Delete" onAction="#deleteSelectedBudget" style="-fx-background-color:rgba(239, 68, 68, 0.2); -fx-border-color:#ef4444; -fx-text-fill:#ef4444; -fx-border-radius:8; -fx-background-radius:8; -fx-cursor:hand;" prefWidth="100"/>
                    <Pane HBox.hgrow="ALWAYS" /> <Button text="Cancel" onAction="#hideEditForm" styleClass="btn-secondary" prefWidth="100"/>
                    <Button text="Update" onAction="#handleUpdateBudget" style="-fx-background-color:#10b981; -fx-text-fill:white; -fx-background-radius:8; -fx-font-weight:bold; -fx-cursor:hand;" prefWidth="100"/>
                </HBox>
            </VBox>
        </StackPane>
    </AnchorPane>
</StackPane>