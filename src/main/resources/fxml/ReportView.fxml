<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<StackPane stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.budgetwise.budgetwise.controllers.ReportController">

    <VBox spacing="25" prefHeight="720.0" prefWidth="1280.0"
          style="-fx-background-color: linear-gradient(to bottom right,#0f172a,#1e293b); -fx-padding:30;">

        <HBox spacing="15" alignment="CENTER_LEFT">
            <Label text="📊 Reports &amp; Analytics"
                   style="-fx-text-fill:white; -fx-font-size:26; -fx-font-weight:bold;"/>

            <Pane HBox.hgrow="ALWAYS" />

            <ComboBox fx:id="rangeBox" promptText="Time Period" prefWidth="180" onAction="#handleRangeChange" />

            <Button text="💾 Export Data" onAction="#showExportModal" styleClass="btn-primary" style="-fx-background-color: linear-gradient(to right,#3b82f6,#8b5cf6); -fx-text-fill:white; -fx-font-weight:bold;" />
        </HBox>

        <HBox spacing="20" VBox.vgrow="ALWAYS">
            <VBox spacing="15" styleClass="card-glass" style="-fx-padding: 20;" HBox.hgrow="ALWAYS">
                <Label text="Expense Allocation" style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;" />
                <PieChart fx:id="expensePieChart" legendSide="RIGHT" VBox.vgrow="ALWAYS" />
            </VBox>

            <VBox spacing="20" styleClass="card-glass" style="-fx-padding: 20; -fx-min-width: 300;">
                <Label text="Smart Insights" style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;" />
                <Label fx:id="insightLabel" wrapText="true" style="-fx-text-fill:#22c55e; -fx-font-size:15;" text="Analyzing your data..." />
                <Label fx:id="emptyLabel" text="No data for this period." visible="false" style="-fx-text-fill:#ef4444;" />
            </VBox>
        </HBox>

        <VBox spacing="15" styleClass="card-glass" style="-fx-padding: 20;" VBox.vgrow="ALWAYS">
            <Label text="Cash Flow (Income vs. Expenses)" style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;" />
            <BarChart fx:id="incomeExpenseChart" VBox.vgrow="ALWAYS">
                <xAxis><CategoryAxis side="BOTTOM" /></xAxis>
                <yAxis><NumberAxis side="LEFT" /></yAxis>
            </BarChart>
        </VBox>
    </VBox>

    <AnchorPane fx:id="exportModalOverlay" style="-fx-background-color: rgba(0,0,0,0.7);" visible="false">
        <StackPane AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
            <VBox alignment="CENTER_LEFT" maxWidth="450" spacing="20" styleClass="modal-dialog" style="-fx-padding:40; -fx-background-color:#111827; -fx-background-radius:20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 20,0,0,10);">

                <Label style="-fx-text-fill:white; -fx-font-size:22; -fx-font-weight:bold;" text="Export Data" />
                <Label style="-fx-text-fill:#9ca3af; -fx-font-size:14;" text="Select your preferred format and data range." wrapText="true"/>

                <VBox spacing="8">
                    <Label style="-fx-text-fill:white;" text="1. Format" />
                    <ComboBox fx:id="exportFormatBox" promptText="Select Format" maxWidth="Infinity" style="-fx-background-color:#1f2937; -fx-text-fill:white;" />
                </VBox>

                <VBox spacing="8">
                    <Label style="-fx-text-fill:white;" text="2. Date Range" />
                    <HBox spacing="15">
                        <DatePicker fx:id="exportStartDate" promptText="Start Date" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                        <DatePicker fx:id="exportEndDate" promptText="End Date" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                    </HBox>
                </VBox>

                <VBox spacing="10">
                    <Label style="-fx-text-fill:white;" text="3. Include Data" />
                    <CheckBox fx:id="checkTransactions" text="Transactions" selected="true" style="-fx-text-fill:white;" />
                    <CheckBox fx:id="checkBudgets" text="Budget Summaries" style="-fx-text-fill:white;" />
                    <CheckBox fx:id="checkGoals" text="Financial Goals" style="-fx-text-fill:white;" />
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="15" style="-fx-padding: 20 0 0 0;">
                    <Button onAction="#hideExportModal" style="-fx-background-color:#374151; -fx-text-fill:white;" text="Cancel" prefWidth="100" />
                    <Button onAction="#handleGenerateAndDownload" style="-fx-background-color:#10b981; -fx-text-fill:white; -fx-font-weight:bold;" text="Generate &amp; Download" prefWidth="180" />
                </HBox>

            </VBox>
        </StackPane>
    </AnchorPane>

</StackPane>