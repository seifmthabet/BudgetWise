<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.budgetwise.budgetwise.controllers.TransactionController">

    <VBox spacing="25" style="-fx-padding:30; -fx-background-color: linear-gradient(to bottom right,#0f172a,#1e293b);">

        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label style="-fx-text-fill:white; -fx-font-size:26; -fx-font-weight:bold;" text="Transactions" />
            <Pane HBox.hgrow="ALWAYS" />
            <Button onAction="#showForm" styleClass="btn-primary" text="+ Add Transaction" />
        </HBox>

        <HBox spacing="20">
            <VBox spacing="5" styleClass="card-glass" style="-fx-padding: 15; -fx-min-width: 200;">
                <Label style="-fx-text-fill:#9ca3af; -fx-font-size:12;" text="Total Transactions" />
                <Label fx:id="totalCountLabel" style="-fx-text-fill:white; -fx-font-size:22; -fx-font-weight:bold;" text="0" />
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="15" styleClass="card-glass" style="-fx-padding: 15;" HBox.hgrow="ALWAYS">
                <Label style="-fx-text-fill:white; -fx-font-weight:bold;" text="Filters:" />
                <TextField fx:id="searchField" promptText="Search description..." prefWidth="200" />
                <ComboBox fx:id="filterTypeCombo" promptText="Type" prefWidth="120" />
                <DatePicker fx:id="filterDatePicker" promptText="Date" prefWidth="150" />
                <Button styleClass="btn-secondary" text="Reset" onAction="#handleResetFilters" />
            </HBox>
        </HBox>

        <VBox spacing="10" styleClass="card-glass" style="-fx-padding:20;" VBox.vgrow="ALWAYS">
            <TableView fx:id="transactionsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="titleColumn" prefWidth="200" text="Description" />
                    <TableColumn fx:id="typeColumn" prefWidth="120" text="Type" />
                    <TableColumn fx:id="amountColumn" prefWidth="120" text="Amount" />
                    <TableColumn fx:id="categoryColumn" prefWidth="150" text="Category" />
                    <TableColumn fx:id="dateColumn" prefWidth="150" text="Date" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>

    <AnchorPane fx:id="formOverlay" style="-fx-background-color: rgba(0,0,0,0.7);" visible="false">
        <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <VBox alignment="CENTER" maxWidth="400" spacing="20" styleClass="modal-dialog" style="-fx-padding:40;">

                <Label style="-fx-text-fill:white; -fx-font-size:22; -fx-font-weight:bold;" text="New Transaction" />

                <TextField fx:id="titleField" promptText="Description" maxWidth="Infinity" />

                <HBox spacing="15">
                    <TextField fx:id="amountField" promptText="Amount ($)" HBox.hgrow="ALWAYS" />
                    <ComboBox fx:id="typeCombo" promptText="Type" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                </HBox>

                <ComboBox fx:id="categoryCombo" promptText="Select Category" maxWidth="Infinity" />
                <ComboBox fx:id="paymentCombo" promptText="Select Payment Method" maxWidth="Infinity" />
                <DatePicker fx:id="datePicker" promptText="Date" maxWidth="Infinity" />

                <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10 0 0 0;">
                    <Button onAction="#hideForm" styleClass="btn-secondary" text="Cancel" prefWidth="110" />
                    <Button onAction="#handleSaveTransaction" style="-fx-background-color:#10b981; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:8;" text="Save" prefWidth="110" />
                </HBox>
            </VBox>
        </StackPane>
    </AnchorPane>

</StackPane>