<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="1080.0" maxWidth="1920.0" prefHeight="720.0" prefWidth="1280.0" spacing="25" style="-fx-background-color: linear-gradient(to bottom right,#0f172a,#1e293b); -fx-padding:30;" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.budgetwise.budgetwise.controllers.DashboardController">

    <Label style="-fx-text-fill:white; -fx-font-size:26; -fx-font-weight:bold;" text="Dashboard" />

    <!-- Cards Container -->
    <HBox alignment="CENTER" spacing="20">
        <!-- Main Balance Card -->
        <VBox spacing="8" style="-fx-padding: 25; -fx-min-width: 250;" styleClass="card-glass">
            <Label styleClass="card-title" text="Total Balance" />
            <Label fx:id="balanceLabel" style="-fx-text-fill:white; -fx-font-size:32; -fx-font-weight:bold;" text="\$0" />
        </VBox>

        <VBox spacing="15">
            <HBox spacing="15">
                <VBox style="-fx-padding: 15; -fx-min-width: 160;" styleClass="card-glass">
                    <Label styleClass="card-title" text="Income" />
                    <Label fx:id="incomeLabel" style="-fx-text-fill:#22c55e; -fx-font-size:20;" text="\$0" />
                </VBox>
                <VBox style="-fx-padding: 15; -fx-min-width: 160;" styleClass="card-glass">
                    <Label styleClass="card-title" text="Expenses" />
                    <Label fx:id="expenseLabel" style="-fx-text-fill:#ef4444; -fx-font-size:20;" text="\$0" />
                </VBox>
            </HBox>
            <HBox spacing="15">
                <VBox style="-fx-padding: 15; -fx-min-width: 100;" styleClass="card-glass">
                    <Label styleClass="card-title" text="Transactions" />
                    <Label fx:id="transactionsLabel" style="-fx-text-fill:white; -fx-font-size:18;" text="0" />
                </VBox>
                <VBox style="-fx-padding: 15; -fx-min-width: 100;" styleClass="card-glass">
                    <Label styleClass="card-title" text="Budgets" />
                    <Label fx:id="budgetsLabel" style="-fx-text-fill:#3b82f6; -fx-font-size:18;" text="0 Active" />
                </VBox>
                <VBox style="-fx-padding: 15; -fx-min-width: 100;" styleClass="card-glass">
                    <Label styleClass="card-title" text="Goals" />
                    <Label fx:id="goalsLabel" style="-fx-text-fill:#f59e0b; -fx-font-size:18;" text="0" />
                </VBox>
            </HBox>
        </VBox>
    </HBox>

    <!-- Table Section -->
    <VBox spacing="15" style="-fx-padding: 20;" styleClass="card-glass" VBox.vgrow="ALWAYS">
        <Label style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;" text="Recent Transactions" />
        <TableView fx:id="transactionsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="titleColumn" prefWidth="250" text="Description" />
                <TableColumn fx:id="typeColumn" prefWidth="150" text="Type" />
                <TableColumn fx:id="amountColumn" prefWidth="150" text="Amount" />
                <TableColumn fx:id="dateColumn" prefWidth="200" text="Date" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>
