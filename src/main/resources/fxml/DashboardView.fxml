<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.budgetwise.budgetwise.controllers.DashboardController"
            style="-fx-background-color: linear-gradient(to bottom right,#0f172a,#1e293b);">

    <top>
        <Pane prefHeight="0"/>
    </top>

    <left>
        <VBox spacing="15"
              style="-fx-background-color:#111827; -fx-padding:20; -fx-pref-width:220;">

            <Label text="BudgetWise"
                   style="-fx-text-fill:white; -fx-font-size:20; -fx-font-weight:bold;"/>

            <Button text="Dashboard" style="-fx-background-color:linear-gradient(to right,#ff7eb3,#ff758c); -fx-text-fill:white;"/>
            <Button text="Transactions" style="-fx-background-color:transparent; -fx-text-fill:#9ca3af;"/>
            <Button text="Budgets" style="-fx-background-color:transparent; -fx-text-fill:#9ca3af;"/>
            <Button text="Goals" style="-fx-background-color:transparent; -fx-text-fill:#9ca3af;"/>
            <Button text="Notifications" style="-fx-background-color:transparent; -fx-text-fill:#9ca3af;"/>
            <Button text="Reports" style="-fx-background-color:transparent; -fx-text-fill:#9ca3af;"/>
        </VBox>
    </left>

    <!-- MAIN -->
    <center>
        <VBox spacing="25" style="-fx-padding:30;">

            <Label text="Dashboard"
                   style="-fx-text-fill:white; -fx-font-size:26;"/>

            <HBox spacing="20">

                <VBox style="-fx-background-color:#1f2937; -fx-padding:20; -fx-background-radius:15;">
                    <Label text="Income" style="-fx-text-fill:#9ca3af;"/>
                    <Label fx:id="incomeLabel" text="/$0" style="-fx-text-fill:white; -fx-font-size:20;"/>
                </VBox>

                <VBox style="-fx-background-color:#1f2937; -fx-padding:20; -fx-background-radius:15;">
                    <Label text="Expenses" style="-fx-text-fill:#9ca3af;"/>
                    <Label fx:id="expenseLabel" text="/$0" style="-fx-text-fill:white; -fx-font-size:20;"/>
                </VBox>

            </HBox>

            <PieChart fx:id="financeChart"
                      prefHeight="250"
                      style="-fx-background-color:#111827; -fx-background-radius:15;"/>

            <VBox spacing="10"
                  style="-fx-background-color:#111827; -fx-padding:15; -fx-background-radius:15;">

                <Label text="Recent Transactions"
                       style="-fx-text-fill:white; -fx-font-size:16;"/>

                <TableView fx:id="transactionsTable"
                           style="-fx-background-color:#1f2937;">

                    <columns>
                        <TableColumn text="Title" prefWidth="150"/>
                        <TableColumn text="Amount" prefWidth="100"/>
                        <TableColumn text="Date" prefWidth="150"/>
                    </columns>

                </TableView>

            </VBox>

        </VBox>
    </center>

</BorderPane>