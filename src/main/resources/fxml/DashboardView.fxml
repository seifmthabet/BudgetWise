<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="borderPane" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: linear-gradient(to bottom right,#0f172a,#1e293b);  " xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.budgetwise.budgetwise.controllers.DashboardController">

    <top>
        <Pane prefHeight="0" />
    </top>

    <left>
        <VBox spacing="15" style="-fx-background-color:#111827; -fx-padding:20; -fx-pref-width:220;">

            <Label style="-fx-text-fill:white; -fx-font-size:20; -fx-font-weight:bold;" text="BudgetWise" />

            <Button fx:id="dashboardBtn" onAction="#goToDashboard" style="-fx-background-color:linear-gradient(to right,#ff7eb3,#ff758c); -fx-text-fill:white;" text="Dashboard" />
            <Button fx:id="transactionBtn" onAction="#goToTransaction" style="-fx-background-color:transparent; -fx-text-fill:#9ca3af;" text="Transactions" />
            <Button fx:id="budgetBtn" onAction="#goToBudget" style="-fx-background-color:transparent; -fx-text-fill:#9ca3af;" text="Budgets" />
            <Button fx:id="goalBtn" onAction="#goToGoal" style="-fx-background-color:transparent; -fx-text-fill:#9ca3af;" text="Goals" />
            <Button fx:id="notificationBtn" onAction="#goToNotification" style="-fx-background-color:transparent; -fx-text-fill:#9ca3af;" text="Notifications" />
            <Button fx:id="reportBtn" onAction="#goToReport" style="-fx-background-color:transparent; -fx-text-fill:#9ca3af;" text="Reports" />
        </VBox>
    </left>

    <center>
        <VBox prefHeight="720.0" prefWidth="1280.0" spacing="25" style="-fx-padding:30;">

            <Label style="-fx-text-fill:white; -fx-font-size:26;" text="Dashboard" />

            <HBox spacing="25" style="-fx-padding: 20;">

                <HBox spacing="20" style="-fx-background-color: #111827; -fx-padding: 25px; -fx-background-radius: 18px;">

                    <VBox spacing="5" style="-fx-background-color:#1f2937;                      -fx-padding:25;                      -fx-background-radius:18;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 10,0,0,4);">

                        <Label style="-fx-text-fill:#9ca3af; -fx-font-size:13;" text="Total Balance" />

                        <Label fx:id="balanceLabel" style="-fx-text-fill:white; -fx-font-size:26; -fx-font-weight:bold;" text="\$0" />
                    </VBox>

                    <VBox spacing="5" style="-fx-background-color:#1f2937;                      -fx-padding:20;                      -fx-background-radius:15;">

                        <Label style="-fx-text-fill:#9ca3af;" text="Income" />

                        <Label fx:id="incomeLabel" style="-fx-text-fill:#22c55e; -fx-font-size:18;" text="\$0" />
                    </VBox>

                    <VBox spacing="5" style="-fx-background-color:#1f2937;                      -fx-padding:20;                      -fx-background-radius:15;">

                        <Label style="-fx-text-fill:#9ca3af;" text="Expenses" />

                        <Label fx:id="expenseLabel" style="-fx-text-fill:#ef4444; -fx-font-size:18;" text="\$0" />
                    </VBox>

                </HBox>


                <HBox spacing="20" style="-fx-background-color: #111827; -fx-padding: 25px; -fx-background-radius: 18px;">

                    <VBox spacing="5" style="-fx-background-color:#1f2937;                      -fx-padding:20;                      -fx-background-radius:15;">

                        <Label style="-fx-text-fill:#9ca3af;" text="Transactions" />

                        <Label fx:id="transactionsLabel" style="-fx-text-fill:white; -fx-font-size:18;" text="15" />
                    </VBox>

                    <VBox spacing="5" style="-fx-background-color:#1f2937;                      -fx-padding:20;                      -fx-background-radius:15;">

                        <Label style="-fx-text-fill:#9ca3af;" text="Budgets" />

                        <Label fx:id="budgetsLabel" style="-fx-text-fill:#3b82f6; -fx-font-size:18;" text="3 Active" />
                    </VBox>

                    <VBox spacing="5" style="-fx-background-color:#1f2937;                      -fx-padding:20;                      -fx-background-radius:15;">

                        <Label style="-fx-text-fill:#9ca3af;" text="Goals" />

                        <Label fx:id="goalsLabel" style="-fx-text-fill:#f59e0b; -fx-font-size:18;" text="2/4" />
                    </VBox>

                </HBox>

            </HBox>

            <VBox spacing="10" style="-fx-background-color:#111827; -fx-padding:15; -fx-background-radius:15;">

                <Label style="-fx-text-fill:white; -fx-font-size:16;" text="Recent Transactions" />

                <TableView fx:id="transactionsTable" style="-fx-background-color:#1f2937;">

                    <columns>
                        <TableColumn fx:id="titleColumn" prefWidth="150" text="Title" />
                        <TableColumn fx:id="typeColumn" prefWidth="150" text="Type" />
                        <TableColumn fx:id="amountColumn" prefWidth="100" text="Amount" />
                        <TableColumn fx:id="dateColumn" prefWidth="150" text="Date" />
                    </columns>

                </TableView>

            </VBox>

        </VBox>
    </center>

</BorderPane>
